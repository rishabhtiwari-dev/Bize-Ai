# Network Configuration
HOST=0.0.0.0
PORT=8000

# LLM Provider Configuration
# The app works out-of-the-box in local extractive mode without any API key.
# To enable full LLM generative capabilities, configure either Groq or OpenAI / Ollama:

# Option A: Groq (Recommended - Fast & Free Tier)
# GROQ_API_KEY=gsk_...
# LLM_MODEL=llama-3.3-70b-versatile

# Option B: OpenAI
# OPENAI_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini

# Option C: Local Ollama (No API Key needed)
# OPENAI_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.2
